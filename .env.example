# =============================================================================
# .env.example -> copy thành .env rồi sửa lại.
#   cp .env.example .env
# KHÔNG BAO GIỜ commit file .env thật (đã có trong .gitignore).
#
# Quy ước: mọi biến ở đây map 1-1 với thuộc tính trong app/core/config.py.
# pydantic-settings sẽ tự đọc, tự ép kiểu (str -> int/bool/list) và validate.
# =============================================================================

# --- Chung -------------------------------------------------------------------
APP_ENV=local                 # local | staging | production
APP_DEBUG=true
APP_NAME=auto-remediation
LOG_LEVEL=INFO                # DEBUG khi cần soi kỹ
LOG_JSON=false                # true khi chạy production (để ELK/Loki parse được)

# --- PostgreSQL --------------------------------------------------------------
# Lưu ý: dùng driver "postgresql+asyncpg" chứ không phải "postgresql" (sync).
DATABASE_URL=postgresql+asyncpg://remediation:remediation@localhost:5432/remediation
DB_ECHO=false                 # true để in ra SQL thật - rất hữu ích khi học ORM
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INCIDENTS=incidents.received
KAFKA_TOPIC_REMEDIATION=remediation.results
KAFKA_CONSUMER_GROUP=remediation-worker
KAFKA_ENABLED=true            # false = chạy chế độ đồng bộ, không cần Kafka

# --- JWT ---------------------------------------------------------------------
# BẮT BUỘC tối thiểu 32 byte (RFC 7518 cho HS256). Sinh secret ngẫu nhiên:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-secret-nay-truoc-khi-len-production-toi-thieu-32-byte
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- gRPC agent (tiến trình chạy trên node hạ tầng để thực thi lệnh) ---------
GRPC_AGENT_TARGET=localhost:50051
GRPC_SERVER_PORT=50051
GRPC_TIMEOUT_SECONDS=15

# --- Bảo vệ webhook đầu vào --------------------------------------------------
WEBHOOK_SHARED_SECRET=secret-cho-ben-thu-3-ky-HMAC
RATE_LIMIT_PER_MINUTE=120

# --- Engine ------------------------------------------------------------------
MAX_CONCURRENT_REMEDIATIONS=5   # số incident xử lý song song tối đa
DEFAULT_STEP_TIMEOUT=30
DRY_RUN=false                   # true = chỉ log ra chứ không thực sự tác động
